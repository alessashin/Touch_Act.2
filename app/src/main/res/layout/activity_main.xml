<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10sp"
    android:background="@drawable/porky"
    android:onClick="onNumberClick"
    android:orientation="vertical"
    android:padding="10sp"


    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_weight="1"
            android:ems="10"
            android:gravity="right"
            android:hint="0"
            android:inputType="number"
            android:textSize="100dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonhistory"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#D0F0C0"
            android:onClick="onHistoryClick"
            android:text="🕒"
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttonpercent"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#C8E6C9"
            android:textColor="#D81B60"
            android:onClick="onPercentClick"
            android:text="%"
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttonAC"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#C8E6C9"
            android:textColor="#D81B60"
            android:onClick="onACClick"
            android:text="AC"
            android:textSize="29sp"
            android:textStyle="bold" />


        <Button
            android:id="@+id/buttondel"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FF80AB"
            android:textColor="#D81B60"
            android:onClick="onDelClick"
            android:text="⌫"
            android:textSize="30sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="100sp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="1"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="2"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button3"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="3"
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttonmult"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFF176"
            android:textColor="#D81B60"
            android:onClick="onOperatorClick"
            android:text="×"
            android:textSize="30sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="4"
            android:textSize="30sp" />


        <Button
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="5"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button6"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="6"
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttonminus"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFF176"
            android:textColor="#D81B60"
            android:onClick="onOperatorClick"
            android:text="-"
            android:textSize="40sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button7"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="7"
            android:textSize="30sp" />


        <Button
            android:id="@+id/button8"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:text="8"
            android:textSize="30sp" />

        <Button
            android:id="@+id/button9"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="9"
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttonplus"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFF176"
            android:textColor="#D81B60"
            android:onClick="onOperatorClick"
            android:text="+"
            android:textSize="30sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button0"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFFB3"
            android:textColor="#555555"
            android:onClick="onNumberClick"
            android:text="0"
            android:textSize="30sp" />


        <Button
            android:id="@+id/buttondot"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFF176"
            android:textColor="#D81B60"
            android:onClick="onNumberClick"
            android:text="."
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttondiv"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#FFF176"
            android:textColor="#D81B60"
            android:onClick="onOperatorClick"
            android:text="÷"
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttonequal"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#81D4FA"
            android:textColor="#D81B60"
            android:onClick="onEqualClick"
            android:text="="
            android:textSize="30sp"
            android:textStyle="bold" />


    </LinearLayout>


</LinearLayout>

